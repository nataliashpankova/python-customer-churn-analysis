# =========================================
# 📊 CUSTOMER CHURN ANALYSIS (PYTHON)
# =========================================

"""
OBJECTIVE:
Analyze customer data to identify factors influencing churn
and provide actionable business recommendations.
"""

# =========================================
# 1. IMPORT LIBRARIES
# =========================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

%matplotlib inline
sns.set(style="whitegrid")


# =========================================
# 2. DATA LOADING
# =========================================

# Load dataset
df = pd.read_csv('data/customer_churn_dataset.csv')

# Preview data
print("First rows:")
display(df.head())


# =========================================
# 3. DATA CLEANING
# =========================================

# Check missing values
print("\nMissing values:")
print(df.isnull().sum())

# Drop missing values
df = df.dropna()

# Check data types
print("\nData types:")
print(df.info())


# =========================================
# 4. EXPLORATORY DATA ANALYSIS (EDA)
# =========================================

# Basic statistics
print("\nStatistics:")
display(df.describe())

# Churn distribution
print("\nChurn distribution:")
print(df['churn'].value_counts())


# =========================================
# 5. VISUAL ANALYSIS
# =========================================

# 📊 Churn distribution
plt.figure()
sns.countplot(x='churn', data=df)
plt.title('Customer Churn Distribution')
plt.savefig('images/churn_distribution.png')
plt.show()


# 📊 Monthly charges vs churn
plt.figure()
sns.boxplot(x='churn', y='monthly_charges', data=df)
plt.title('Monthly Charges vs Churn')
plt.savefig('images/charges_vs_churn.png')
plt.show()


# 📊 Tenure vs churn
plt.figure()
sns.boxplot(x='churn', y='tenure', data=df)
plt.title('Tenure vs Churn')
plt.savefig('images/tenure_vs_churn.png')
plt.show()


# 📊 Correlation heatmap
plt.figure(figsize=(10,6))
sns.heatmap(df.corr(numeric_only=True), annot=True, cmap='coolwarm')
plt.title('Correlation Heatmap')
plt.savefig('images/correlation_heatmap.png')
plt.show()


